{
  "name": "Python Dev Environment",

  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "workspaceFolder": "/app",

  "forwardPorts": [8000],

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },

  "mounts": ["source=${localWorkspaceFolder},target=/app/,type=bind"]
}
